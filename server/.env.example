# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB (local) or Atlas connection string
MONGODB_URI=mongodb+srv://<dhruvbansalmkb_db_user>:n5Z8jEA0mBhtZQaZ@cluster0.b63yrfy.mongodb.net/
FRONTEND_ORIGIN=http://localhost:5173

# Exact origin of the frontend (no trailing slash). Used for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=9b46305667c4090168b5f1e86ddb5b4729534432b981674a2f03b37257f113f1
JWT_EXPIRES_DAYS=7

# Cross-site frontend/API in production: none (requires HTTPS). Same-site / dev proxy: lax.
COOKIE_SAMESITE=lax
# Set true when running behind a reverse proxy / PaaS so rate limits see real client IPs.
TRUST_PROXY=false

# Payments: "razorpay" (needs keys below) or "mock" (local sandbox only, refused in production).
# Leave blank to auto-select: razorpay when keys are present, otherwise mock.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Private file storage directory (local disk provider). Must not be served publicly.
PRIVATE_STORAGE_DIR=

# Optional tuning
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
DOWNLOAD_HOURLY_LIMIT=20

# Seed script only (creates / promotes the first admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
