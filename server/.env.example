# Copy to server/.env and fill in. NEVER commit server/.env (it is git-ignored).
NODE_ENV=development
PORT=5000

# MongoDB: local (mongodb://127.0.0.1:27017/rankora) or an Atlas connection string.
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rankora
MONGODB_URI=mongodb://127.0.0.1:27017/rankora

# Exact origin of the frontend (no trailing slash). Used for CORS and email links.
FRONTEND_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# Admin sessions are separate from student sessions and shorter-lived.
ADMIN_SESSION_HOURS=8

# Cross-site frontend/API in production: none (requires HTTPS). Same-site / dev proxy: lax.
COOKIE_SAMESITE=lax
# Set true when running behind a reverse proxy / PaaS so rate limits see real client IPs.
TRUST_PROXY=false

# Payments: "razorpay" (needs keys below), "mock" (local sandbox only, refused in production) or "disabled"
# (checkout says payments are not open yet). Leave blank to auto-select: razorpay when keys are present,
# otherwise mock in development and disabled in production.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where original PDFs and covers live: disk (default; needs a persistent volume) or gridfs (inside MongoDB,
# for hosts whose disk is wiped on restart, such as free tiers).
STORAGE_DRIVER=disk
# Private file directory. For disk storage it must NOT be served publicly. For gridfs it only holds the
# disposable per-student watermarked copies. Defaults to server/storage/private.
PRIVATE_STORAGE_DIR=

# true = this server also serves the built website (run `npm run build` in the project root first), so one
# service can run everything on a single address.
SERVE_FRONTEND=false

# Uploads
MAX_PDF_MB=60
MAX_COVER_MB=2

# Secure reader
READER_SESSION_MINUTES=30        # sliding idle lifetime of a reading session
READER_MAX_SESSION_HOURS=12      # absolute lifetime
READER_MAX_ACTIVE_SESSIONS=3     # per student; opening another closes the oldest
READER_HOURLY_OPEN_LIMIT=30      # reader sessions a student may open per hour
DERIVED_TTL_HOURS=6              # how long per-student watermarked copies are cached on disk

# Email (password reset). Any SMTP provider works (Brevo, SES, Gmail app password...).
# Without SMTP_URL, reset links are printed to the server log in development only.
SMTP_URL=                         # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM=JEEdge <no-reply@example.com>
SUPPORT_EMAIL=

# Optional tuning
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Only used by `npm run seed` (development demo data). Do not put real credentials in files;
# prefer `npm run create-admin`, which prompts for the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Growth programs (both are OFF unless set to true). Money is in paise; percentages are whole numbers.
REFERRALS_ENABLED=false           # refer and earn: friend discount + referrer store credit
TEACHER_PROGRAM_ENABLED=false     # offline teacher codes, commissions and milestone bonuses
FRIEND_DISCOUNT=5000              # paise off a friend's first paid order
REFERRER_CREDIT=5000              # paise of store credit for the referrer
REFERRAL_MONTHLY_CAP=10           # rewards one referrer can earn per calendar month
TEACHER_STUDENT_DISCOUNT_PERCENT=15
TEACHER_COMMISSION_PERCENT=20
REFUND_WINDOW_DAYS=7              # rewards, commissions and milestones become final after this
ATTRIBUTION_DAYS=30               # how long a /?t=CODE or /?ref=CODE link is remembered
# TEACHER_MILESTONES=[{"students":50,"giftValuePaise":50000},{"students":100,"giftValuePaise":150000}]

# The coupon applied automatically at checkout when no teacher code, friend discount or typed code is in play
# (one discount at a time; a teacher always wins). It is a normal coupon in Admin > Offers; this is only its code.
# Leave empty to turn automatic discounts off.
WELCOME_COUPON=WELCOME10
