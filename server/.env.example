# Copy to server/.env and fill in. NEVER commit server/.env (it is git-ignored).
NODE_ENV=development
PORT=5000

# MongoDB: local (mongodb://127.0.0.1:27017/rankora) or an Atlas connection string.
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rankora
MONGODB_URI=mongodb://127.0.0.1:27017/rankora

# Exact origin of the frontend (no trailing slash). Used for CORS and email links.
FRONTEND_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# Admin sessions are separate from student sessions and shorter-lived.
ADMIN_SESSION_HOURS=8

# Cross-site frontend/API in production: none (requires HTTPS). Same-site / dev proxy: lax.
COOKIE_SAMESITE=lax
# Set true when running behind a reverse proxy / PaaS so rate limits see real client IPs.
TRUST_PROXY=false

# Payments: "razorpay" (needs keys below), "mock" (local sandbox only, refused in production) or "disabled"
# (checkout says payments are not open yet). Leave blank to auto-select: razorpay when keys are present,
# otherwise mock in development and disabled in production.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Private file storage directory (local-disk provider). Must NOT be served publicly and must be
# a persistent volume in production. Defaults to server/storage/private.
PRIVATE_STORAGE_DIR=

# Uploads
MAX_PDF_MB=60
MAX_COVER_MB=2

# Secure reader
READER_SESSION_MINUTES=30        # sliding idle lifetime of a reading session
READER_MAX_SESSION_HOURS=12      # absolute lifetime
READER_MAX_ACTIVE_SESSIONS=3     # per student; opening another closes the oldest
READER_HOURLY_OPEN_LIMIT=30      # reader sessions a student may open per hour
DERIVED_TTL_HOURS=6              # how long per-student watermarked copies are cached on disk

# Email (password reset). Any SMTP provider works (Brevo, SES, Gmail app password...).
# Without SMTP_URL, reset links are printed to the server log in development only.
SMTP_URL=                         # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM=Rankora <no-reply@example.com>
SUPPORT_EMAIL=

# Optional tuning
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Only used by `npm run seed` (development demo data). Do not put real credentials in files;
# prefer `npm run create-admin`, which prompts for the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
